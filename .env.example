# Copy this file to .env in the REPO ROOT (next to server/ and reviews.csv).
# The server loads it from there automatically.

# Server
PORT=3000
NODE_ENV=development

# CORS: set to your frontend origin in production
CORS_ORIGIN=http://localhost:5173

# Groq AI
# Get your key at https://console.groq.com
# REQUIRED in non-test environments
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=your_key_here

# Check https://console.groq.com/docs/models for the current model list.
# Default: openai/gpt-oss-120b (reasoning model on Groq).
# Update this if Groq deprecates the model.
GROQ_MODEL=openai/gpt-oss-120b

# Reasoning effort for the model: low | medium | high
GROQ_REASONING_EFFORT=low

# Max tokens the model may produce (reasoning tokens count toward this limit)
GROQ_MAX_OUTPUT_TOKENS=2048

# Request timeout in milliseconds
REQUEST_TIMEOUT_MS=30000

# SQLite cache file path (relative to server/)
DB_PATH=./reviewlens.db

# AI batching
BATCH_SIZE=5
MAX_RETRIES=3
# Base delay in ms for exponential backoff
RETRY_BASE_DELAY_MS=1000
# Maximum delay in ms for exponential backoff (cap)
RETRY_MAX_DELAY_MS=30000

# Upload limits
MAX_FILE_SIZE_MB=5
MAX_REVIEWS=500
# Reviews longer than this are truncated before sending to the AI
MAX_REVIEW_CHARS=1000

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
