# Server
PORT=3000
NODE_ENV=development

# CORS: set to your frontend origin in production
CORS_ORIGIN=http://localhost:5173

# Groq AI
# Get your key at https://console.groq.com
# REQUIRED in non-test environments
GROQ_API_KEY=your_key_here

# Check https://console.groq.com/docs/models for the current model list.
# Recommended free-tier model at time of writing: llama-3.3-70b-versatile
# Update this if Groq deprecates the model.
GROQ_MODEL=llama-3.3-70b-versatile

# SQLite cache file path (relative to server/)
DB_PATH=./reviewlens.db

# AI batching
BATCH_SIZE=5
MAX_RETRIES=3
# Base delay in ms for exponential backoff
RETRY_BASE_DELAY_MS=1000

# Upload limits
MAX_FILE_SIZE_MB=5
MAX_REVIEWS=500
# Reviews longer than this are truncated before sending to the AI
MAX_REVIEW_CHARS=1000

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
